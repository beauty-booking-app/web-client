# URL base del backend. Si no se define, la app apunta a producción
# (DEFAULT_API_URL en src/services/api.js).
# Dev: descomentar y apuntar al backend local.
# VITE_API_URL=http://localhost:8000

# Clave compartida con el backend para firmar el token de reserva anónima
# (X-Client-Token). Debe coincidir con CLIENT_TOKEN_SECRET del backend.
# Generar con: openssl rand -hex 32
# VITE_CLIENT_TOKEN_SECRET=
